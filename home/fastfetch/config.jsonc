{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/.config/fastfetch/images/rei.png",
      "type": "kitty",
      "height": 27,
    },
    "display": {
      "separator": " ➜  ",
    },
    "modules": [
      "break",
      "break",
      "break",
      {
        "type": "os",
        "key": "OS   ",
        "keyColor": "36", // = color1
      },
      {
        "type": "kernel",
        "key": " ├  ",
        "keyColor": "36",
      },
      {
        "type": "shell",
        "key": " ├  ",
        "keyColor": "36",
      },
      {
        "type": "uptime",
        "format": "Uptime: {2}h{3}m{4}s",
        "key": " └ 󰏖 ",
        "keyColor": "36",
      },
      "break",
      {
        "type": "wm",
        "key": "WM   ",
        "keyColor": "31",
      },
      {
        "type": "wmtheme",
        "key": " ├ 󰉼 ",
        "keyColor": "31",
      },
      {
        "type": "icons",
        "key": " ├ 󰀻 ",
        "keyColor": "31",
      },
      {
        "type": "cursor",
        "key": " ├  ",
        "keyColor": "31",
      },
      {
        "type": "terminal",
        "key": " ├  ",
        "keyColor": "31",
      },
      {
        "type": "terminalfont",
        "key": " └  ",
        "keyColor": "31",
      },
      "break",
      {
        "type": "host",
        "format": "{5} {1} Type {2}",
        "key": "PC   ",
        "keyColor": "35",
      },
      {
        "type": "cpu",
        "format": "{1} ({3}) @ {7} GHz",
        "key": " ├  ",
        "keyColor": "35",
      },
      {
        "type": "gpu",
        "format": "{1} {2} @ {12} GHz",
        "key": " ├ 󰢮 ",
        "keyColor": "35",
      },
      {
        "type": "memory",
        "format": "RAM: {1}/{2} {3}",
        "key": " ├  ",
        "keyColor": "35",
      },
      {
        "type": "swap",
        "format": "Swap: {1}/{2} {3}",
        "key": " ├ 󰓡 ",
        "keyColor": "35",
      },
      {
        "type": "disk",
        "format": "Hard Disk: {1}/{2} {10}({9})",
        "key": " ├ 󰋊 ",
        "keyColor": "35",
      },
      {
        "type": "monitor",
        "key": " └  ",
        "keyColor": "35",
      },
      "break",
      "break",
    ],
  }
  