// niri config: a minimal desktop around dmsh, from dm-desktop
// (https://github.com/Kexfff/dm-desktop). These files live in nixos-cfg/dotfiles and
// ~/.config links straight to them, so edits apply on save (no rebuild needed).

include "dm-desktop/base.kdl"
include "dm-desktop/startup.kdl"
include "dm-desktop/binds.kdl"

// dmsh: its keybinds. Generated by modules/desktop/dm-desktop.nix (`dmsh niri`).
include "dmsh.kdl"

// Settings for this machine: outputs, keyboard layout, apps, overrides.
// Included last, so a bind or setting here replaces the one above.
include "local.kdl"

// Settings made in DM Manager. Keep this last so they win over the files above.
include optional=true "dm-manager.kdl"
