// The desktop daemons dmsh leaves out. They start with niri (log in again after
// changing this file).

// Polkit agent (password prompts from apps): a systemd user service that starts with
// niri, set up in modules/desktop/dm-desktop.nix.

// Idle and lock: screen off, lock, lock before sleep. Timings: ~/.config/swayidle/config,
// the lock screen: ~/.config/hypr/hyprlock.conf. -w holds suspend until the lock is up.
spawn-at-startup "swayidle" "-w"

// Wallpaper. awww-daemon restores the last image; set one with `awww img FILE` or Ctrl+Alt+T.
spawn-at-startup "awww-daemon"

// Launcher: elephant is walker's backend (apps, clipboard history, menus, calculator);
// walker stays resident so it opens instantly. Both run as user services tied to the
// session, so they restart if they crash: `journalctl --user -u elephant -u walker`.
spawn-at-startup "systemd-run" "--user" "--collect" "--unit=elephant" "--property=PartOf=graphical-session.target" "--property=Restart=on-failure" "elephant"
spawn-at-startup "systemd-run" "--user" "--collect" "--unit=walker" "--property=PartOf=graphical-session.target" "--property=Restart=on-failure" "walker" "--gapplication-service"

spawn-sh-at-startup "systemctl --user import-environment XDG_MENU_PREFIX && kbuildsycoca6"
spawn-sh-at-startup "command -v niri-focused-booster >/dev/null && [ -r /sys/fs/cgroup/dmem.capacity ] && exec niri-focused-booster"
